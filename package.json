{
  "name": "stableworker",
  "version": "0.9.6",
  "description": "自研 AI 代理编程软件 —— Electron 桌面应用",
  "main": "./out/main/index.js",
  "author": "david",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "dist": "electron-vite build && electron-builder --publish never",
    "verify:release": "node scripts/verify-release-assets.mjs",
    "check:version": "node scripts/check-release-version.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "docx": "^9.11.0",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "fast-formula-parser": "1.0.19",
    "fast-xml-parser": "^5.11.2",
    "highlight.js": "^11.12.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.13.0",
    "pdf-parse": "^2.4.5",
    "pptxgenjs": "^4.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tesseract.js": "7.0.0",
    "undici": "^8.11.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^5.0.3",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "js-yaml": "^4.3.2",
    "typescript": "^5.9.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.3"
  },
  "build": {
    "appId": "com.david.stableworker",
    "productName": "StableWorker",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**"
    ],
    "asarUnpack": [
      "out/main/**",
      "node_modules/{tesseract.js,tesseract.js-core,bmp-js,idb-keyval,is-url,node-fetch,whatwg-url,tr46,webidl-conversions,opencollective-postinstall,regenerator-runtime,wasm-feature-detect,zlibjs}/**/*"
    ],
    "extraResources": [
      { "from": "resources/ocr", "to": "ocr" }
    ],
    "win": {
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "icon": "build/icon.png",
    "publish": [
      {
        "provider": "github",
        "owner": "davidapp",
        "repo": "stableworker"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/davidapp/stableworker.git"
  },
  "overrides": {
    "pptxgenjs": {
      "image-size": "2.0.4"
    },
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
